# Multica 环境配置 (Ansible 渲染, 含敏感信息, 0600)
# backend 经 env_file 全量加载; postgres 经 compose ${} 插值
# 仅注入首期所需变量, 未注入项走镜像/服务端默认 (见 docker-compose.selfhost.yml)

# --- 基础 ---
TZ={{ multica_tz }}
APP_ENV={{ multica_app_env }}

# --- PostgreSQL (服务端初始化 + backend 连接) ---
# 密码须为 hex 等 URL-safe 字符 (openssl rand -hex 32), 避免 DATABASE_URL 转义
POSTGRES_USER={{ multica_postgres_user }}
POSTGRES_PASSWORD={{ multica_postgres_password }}
POSTGRES_DB={{ multica_postgres_db }}
DATABASE_URL=postgres://{{ multica_postgres_user }}:{{ multica_postgres_password }}@postgres:5432/{{ multica_postgres_db }}?sslmode=disable

# --- 认证 (JWT 签名, 必填) ---
JWT_SECRET={{ multica_jwt_secret }}

# --- 公网 URL: 单 origin, 全部从 hostname 派生; 不设 COOKIE_DOMAIN = host-only cookies ---
# 暂不配邮件: RESEND/SMTP 留空, 验证码打印在 backend 日志 ("[DEV] Verification code for ...")
FRONTEND_ORIGIN={{ multica_public_origin }}
MULTICA_APP_URL={{ multica_public_origin }}
MULTICA_PUBLIC_URL={{ multica_public_origin }}
CORS_ALLOWED_ORIGINS={{ multica_public_origin }}

# --- 注册白名单: ALLOW_SIGNUP=false 时白名单是允许注册的例外; 空名单 = 关闭所有新注册
# lower: 防 YAML bool False 渲染为 'False' (后端仅识别小写 'false')
ALLOW_SIGNUP={{ multica_allow_signup | string | lower }}
ALLOWED_EMAILS={{ multica_allowed_emails | join(',') }}
ALLOWED_EMAIL_DOMAINS=

# --- 反向代理 (Traefik @ proxy_net): auth 限流 + webhook/realtime 的 XFF 信任 ---
MULTICA_TRUSTED_PROXIES={{ multica_trusted_proxies }}
RATE_LIMIT_TRUSTED_PROXIES={{ multica_trusted_proxies }}

# --- 扩展: 显式关闭 selfhost Compose 默认开启的 VCS 集成 (Forgejo/Gitea/GitLab); 与 GitHub App 集成无关 ---
MULTICA_VCS_INTEGRATION_ENABLED={{ multica_vcs_integration_enabled }}

# --- GitHub App 集成 (可选): 四项全空 = 未启用 ---
# PRIVATE_KEY 用 to_json 渲染: PEM 换行转 \n 并加双引号, 由 Compose env_file 解码回真实换行
GITHUB_APP_SLUG={{ multica_github_app_slug }}
GITHUB_APP_ID={{ multica_github_app_id }}
# replace($->$$) 防 Compose 插值, to_json 安全引用引号/空格/#
GITHUB_WEBHOOK_SECRET={{ multica_github_webhook_secret | replace("$", "$$") | to_json }}
GITHUB_APP_PRIVATE_KEY={{ multica_github_app_private_key | to_json }}
