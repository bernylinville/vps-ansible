# Sub2API 环境配置 (Ansible 渲染，包含敏感信息，权限 0600)
# 应用容器通过 env_file 加载；postgres/redis 通过 compose 变量插值引用

# --- Server ---
AUTO_SETUP=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE={{ sub2api_server_mode }}
TZ={{ sub2api_tz }}

# --- PostgreSQL (应用侧连接) ---
DATABASE_HOST={{ sub2api_postgres_container_name }}
DATABASE_PORT=5432
DATABASE_USER={{ sub2api_postgres_user }}
DATABASE_PASSWORD={{ sub2api_postgres_password }}
DATABASE_DBNAME={{ sub2api_postgres_db }}
DATABASE_SSLMODE=disable

# --- PostgreSQL (服务端初始化，compose 插值) ---
POSTGRES_USER={{ sub2api_postgres_user }}
POSTGRES_PASSWORD={{ sub2api_postgres_password }}
POSTGRES_DB={{ sub2api_postgres_db }}

# --- Redis ---
REDIS_HOST={{ sub2api_redis_container_name }}
REDIS_PORT=6379
REDIS_PASSWORD={{ sub2api_redis_password }}
REDIS_DB=0

# --- Admin (密码留空则首次启动自动生成并打印在日志中) ---
ADMIN_EMAIL={{ sub2api_admin_email }}
ADMIN_PASSWORD={{ sub2api_admin_password }}

# --- JWT / TOTP 固定密钥，防止重启后会话与 2FA 失效 ---
JWT_SECRET={{ sub2api_jwt_secret }}
JWT_EXPIRE_HOUR={{ sub2api_jwt_expire_hour }}
TOTP_ENCRYPTION_KEY={{ sub2api_totp_encryption_key }}

# --- Security ---
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP={{ sub2api_allow_insecure_http }}

# --- Reverse proxy (信任 Traefik 转发的真实客户端 IP) ---
SERVER_TRUSTED_PROXIES={{ sub2api_trusted_proxies }}

# --- OpenAI WS mode router v2 (账号级 http_bridge 需开启后生效) ---
GATEWAY_OPENAI_WS_MODE_ROUTER_V2_ENABLED={{ sub2api_gateway_openai_ws_mode_router_v2_enabled }}
GATEWAY_OPENAI_WS_INGRESS_MODE_DEFAULT={{ sub2api_gateway_openai_ws_ingress_mode_default }}
