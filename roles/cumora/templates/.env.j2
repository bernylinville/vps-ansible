# Ansible 管理，包含敏感配置，权限 0600。
NODE_ENV=production
PORT=5181
TZ={{ cumora_tz }}
POSTGRES_USER={{ cumora_postgres_user }}
POSTGRES_DB={{ cumora_postgres_db }}
POSTGRES_PASSWORD={{ cumora_postgres_password }}
DATABASE_URL=postgres://{{ cumora_postgres_user }}:{{ cumora_postgres_password }}@postgres:5432/{{ cumora_postgres_db }}
REDIS_URL=redis://redis:6379
OPENAI_API_KEY={{ cumora_openai_api_key | to_json | replace('$', '$$') }}
AGENT_RUNTIME_SECRET={{ cumora_agent_runtime_secret | to_json | replace('$', '$$') }}
CUMORA_PUBLIC_ORIGIN={{ cumora_public_origin }}
CUMORA_AUTH_DONE_URL={{ cumora_public_origin }}/
# 保留末尾 /，上游按前缀匹配，避免 evil.example.com 之类的 origin 混淆。
CUMORA_AUTH_RETURN_ALLOWLIST={{ cumora_public_origin }}/,cumora://auth
CUMORA_INVITE_BASE_URL={{ cumora_public_origin }}
PUBLIC_HOST={{ cumora_hostname }}
CUMORA_ADMIN_EMAILS={{ cumora_admin_emails | join(',') | to_json | replace('$', '$$') }}
GITHUB_CLIENT_ID={{ cumora_github_client_id | to_json | replace('$', '$$') }}
GITHUB_CLIENT_SECRET={{ cumora_github_client_secret | to_json | replace('$', '$$') }}
